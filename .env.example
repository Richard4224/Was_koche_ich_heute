# Copy to .env and fill in; .env is not committed. All settings are optional.

# The contact form goes through FormSubmit to the address in the Impressum. After activating the form,
# FormSubmit emails you a random alias for it; put it here so the address itself isn't sent along.
FORMSUBMIT_TO=

# Behind a reverse proxy like Caddy: how many proxies there are (usually 1), so visitors' IP addresses are right
PROXY_COUNT=0
