# Copy to .env and fill in; .env is not committed. All settings are optional.

# The contact form sends through this mail account. For Gmail: turn on 2-step verification and create an
# app password at https://myaccount.google.com/apppasswords (not your normal password).
MAIL_USERNAME=
MAIL_PASSWORD=
# Where messages go (default: MAIL_USERNAME)
CONTACT_TO=

# Behind a reverse proxy like Caddy: how many proxies there are (usually 1), so visitors' IP addresses are right
PROXY_COUNT=0
